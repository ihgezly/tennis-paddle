4) دالة موحّدة لتحديد ثيم كل قسم (Sport Theme)

بدل ما نكرر شرط if padel then blue else orange في كل مكون، نعمل helper واحد نستخدمه في كل حتة:

ts
// src/lib/core/util.ts — إضافة

export type SportTheme = {
  color: string;       // CSS var name
  glow: string;         // rgba للـ box-shadow
  label: string;
};

export function getSportTheme(slugOrTitle: string): SportTheme {
  const key = (slugOrTitle || "").toLowerCase();

  if (key.includes("padel") || key.includes("بادل")) {
    return { color: "var(--padel-blue)", glow: "rgba(41,199,255,0.35)", label: "Padel" };
  }
  if (key.includes("tennis") || key.includes("تنس")) {
    return { color: "var(--tennis-orange)", glow: "rgba(255,99,56,0.35)", label: "Tennis" };
  }
  if (key.includes("shoe") || key.includes("shoes") || key.includes("حذاء") || key.includes("احذية")) {
    return { color: "var(--shoes-green)", glow: "rgba(62,207,142,0.35)", label: "Shoes" };
  }
  return { color: "var(--gold)", glow: "rgba(212,175,106,0.3)", label: "General" };
}
