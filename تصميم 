tsx
// src/components/home/new-arrivals/new-arrivals-carousel.tsx
"use client";

import useEmblaCarousel from "embla-carousel-react";
import { useCallback, useEffect, useState } from "react";

export default function NewArrivalsCarousel({
  children,
}: {
  children: React.ReactNode[];
}) {
  const [emblaRef, emblaApi] = useEmblaCarousel({
    align: "start",
    dragFree: false,
    containScroll: "trimSnaps",
  });
  const [selected, setSelected] = useState(0);

  const onSelect = useCallback(() => {
    if (emblaApi) setSelected(emblaApi.selectedScrollSnap());
  }, [emblaApi]);

  useEffect(() => {
    if (!emblaApi) return;
    emblaApi.on("select", onSelect);
    onSelect();
  }, [emblaApi, onSelect]);

  return (
    <div className="overflow-hidden" ref={emblaRef}>
      <div className="flex gap-4">
        {children.map((child, i) => (
          <div
            key={i}
            className="min-w-0 flex-[0_0_45%] sm:flex-[0_0_30%] lg:flex-[0_0_19%] transition-all duration-500"
            style={{
              transform: i === selected ? "scale(1)" : "scale(0.96)",
              opacity: Math.abs(i - selected) > 2 ? 0.6 : 1,
            }}
          >
            {child}
          </div>
        ))}
      </div>
    </div>
  );
}

وفي new-arrivals.tsx تلف الـ .map بتاع الكروت جوه <NewArrivalsCarousel> بدل الـ <div className="grid ...">. الانيميشن هنا بسيط ومش معقد زي ما طلبت: تكبير خفيف للكارت النشط + سلاسة في السحب، من غير أي مكتبة إضافية.
