2) صفحة تسجيل الدخول/الحساب — نص مضرب متوهج

عندك حاليًا في auth-shell.tsx placeholder بسيط (دايرة بيضاوية بتتلون). هستبدله بنص مضرب حقيقي (SVG) بيدخل بانيميشن ويتوهّج حسب الوضع:

tsx
// src/components/auth/racket-glow.tsx
"use client";

export default function RacketGlow({ mode }: { mode: "padel" | "tennis" }) {
  const isPadel = mode === "padel";
  const color = isPadel ? "var(--padel-blue)" : "var(--tennis-orange)";
  const side = isPadel ? "left" : "right"; // نص الشمال للبادل، نص اليمين للتنس

  return (
    <div
      className="relative h-80 w-80"
      style={{
        clipPath:
          side === "left" ? "inset(0 50% 0 0)" : "inset(0 0 0 50%)",
        animation: "racket-reveal .9s cubic-bezier(.16,1,.3,1) forwards",
      }}
    >
      <svg viewBox="0 0 200 300" className="h-full w-full">
        <defs>
          <filter id="glow">
            <feGaussianBlur stdDeviation="6" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {/* رأس المضرب */}
        <ellipse
          cx="100" cy="110" rx="75" ry="95"
          fill="none" stroke={color} strokeWidth="6"
          filter="url(#glow)"
          style={{ animation: "pulse-glow 2.4s ease-in-out infinite" }}
        />
        {/* الأوتار */}
        {Array.from({ length: 6 }).map((_, i) => (
          <line key={`v${i}`} x1={45 + i * 22} y1="25" x2={45 + i * 22} y2="195"
            stroke={color} strokeOpacity="0.35" strokeWidth="1.2" />
        ))}
        {Array.from({ length: 7 }).map((_, i) => (
          <line key={`h${i}`} x1="30" y1={35 + i * 24} x2="170" y2={35 + i * 24}
            stroke={color} strokeOpacity="0.35" strokeWidth="1.2" />
        ))}
        {/* اليد */}
        <rect x="92" y="200" width="16" height="90" rx="8" fill={color} filter="url(#glow)" />
      </svg>
    </div>
  );
}
