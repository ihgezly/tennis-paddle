// src/components/sell/sell-equipment-form.tsx
"use client";

import { useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { toast } from "sonner";
import { FiUploadCloud, FiX } from "react-icons/fi";

import { getSportTheme } from "@/lib/core/util";

const CONDITION_TYPES = [
  { code: "new", label: "جديد" },
  { code: "used", label: "مستعمل" },
] as const;

const CONDITION_GRADES = [
  { code: "like_new", label: "كسر زيرو", accent: true },
  { code: "excellent", label: "ممتاز", accent: false },
  { code: "good", label: "جيد", accent: false },
  { code: "fair", label: "مقبول", accent: false },
] as const;

const FIELD_CLASS =
  "w-full rounded-lg border border-border bg-surface-2 px-4 py-2.5 text-sm text-foreground placeholder:text-text-muted transition focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/20";

export default function SellEquipmentForm() {
  const router = useRouter();
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [images, setImages] = useState<File[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [category, setCategory] = useState("");
  const [conditionType, setConditionType] = useState<"new" | "used">("new");
  const [conditionGrade, setConditionGrade] = useState<string>("");

  const sportTheme = useMemo(() => getSportTheme(category), [category]);
  const showSportChip = sportTheme.key !== "general" && category.trim().length > 0;

  const previews = useMemo(
    () => images.map((file) => ({ file, url: URL.createObjectURL(file) })),
    [images],
  );

  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []);
    const next = [...images, ...files].slice(0, 10);
    setError(next.length < 5 ? "يجب رفع 5 صور على الأقل." : null);
    setImages(next);
    e.target.value = "";
  };

  const removeImage = (index: number) => {
    setImages((prev) => prev.filter((_, i) => i !== index));
  };

  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    if (images.length < 5) {
      setError("يجب رفع 5 صور على الأقل.");
      return;
    }
    setIsSubmitting(true);
    setError(null);
    try {
      const imageIds: number[] = [];
      for (const file of images) {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("alt", file.name);
        const res = await fetch("/api/media", { method: "POST", body: fd });
        if (!res.ok) throw new Error("فشل رفع إحدى الصور");
        imageIds.push((await res.json()).doc.id);
      }

      const formData = new FormData(e.currentTarget);
      const payload = {
        title: formData.get("title"),
        category,
        brand: formData.get("brand") || undefined,
        description: formData.get("description"),
        conditionType,
        conditionGrade: conditionType === "used" ? conditionGrade || undefined : undefined,
        askingPrice: Number(formData.get("askingPrice")),
        currencyCode: "EGP",
        images: imageIds.map((id) => ({ image: id })),
      };

      const res = await fetch("/api/sell-requests", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error((await res.json()).message || "فشل إرسال الطلب");

      toast.success("تم إرسال طلب البيع بنجاح");
      router.push("/account/orders/sell-requests");
      router.refresh();
    } catch (err: any) {
      setError(err.message || "حدث خطأ ما");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <form
      onSubmit={handleSubmit}
      className="mx-auto flex w-full max-w-2xl flex-col gap-8 rounded-2xl border border-border bg-surface p-6 md:p-8"
    >
      {/* بيانات المنتج */}
      <section className="flex flex-col gap-4">
        <h2 className="text-sm font-semibold uppercase tracking-wider text-text-secondary">
          بيانات المنتج
        </h2>

        <div>
          <label className="mb-1.5 block text-sm font-medium">اسم المنتج *</label>
          <input name="title" required minLength={3} maxLength={120} className={FIELD_CLASS} placeholder="مثال: مضرب بادل Bullpadel Vertex" />
        </div>

        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label className="mb-1.5 block text-sm font-medium">القسم *</label>
            <div className="relative">
              <input
                name="category"
                required
                value={category}
                onChange={(e) => setCategory(e.target.value)}
                placeholder="padel-rackets"
                className={FIELD_CLASS}
              />
              {showSportChip && (
                <span
                  className="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 rounded-full px-2.5 py-0.5 text-[11px] font-medium"
                  style={{
                    backgroundColor: `color-mix(in srgb, ${sportTheme.hex} 20%, transparent)`,
                    color: sportTheme.hex,
                  }}
                >
                  {sportTheme.label}
                </span>
              )}
            </div>
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-medium">الماركة</label>
            <input name="brand" maxLength={80} className={FIELD_CLASS} placeholder="اختياري" />
          </div>
        </div>
      </section>

      {/* الحالة */}
      <section className="flex flex-col gap-4 border-t border-border pt-6">
        <h2 className="text-sm font-semibold uppercase tracking-wider text-text-secondary">
          الحالة
        </h2>

        <div className="flex gap-2">
          {CONDITION_TYPES.map((c) => (
            <button
              key={c.code}
              type="button"
              onClick={() => {
                setConditionType(c.code);
                if (c.code === "new") setConditionGrade("");
              }}
              className={`rounded-full border px-5 py-2 text-sm font-medium transition ${
                conditionType === c.code
                  ? "border-gold bg-gold text-black"
                  : "border-border bg-surface-2 text-foreground/80 hover:border-gold/50"
              }`}
            >
              {c.label}
            </button>
          ))}
        </div>

        {conditionType === "used" && (
          <div className="flex flex-wrap gap-2">
            {CONDITION_GRADES.map((g) => {
              const selected = conditionGrade === g.code;
              return (
                <button
                  key={g.code}
                  type="button"
                  onClick={() => setConditionGrade(g.code)}
                  className="rounded-full border px-4 py-1.5 text-sm font-medium transition"
                  style={
                    selected
                      ? {
                          borderColor: "var(--gold)",
                          backgroundColor: "var(--gold)",
                          color: "#0a0a10",
                          boxShadow: g.accent ? "0 0 14px rgba(212,175,106,0.55)" : "none",
                        }
                      : {
                          borderColor: "var(--border)",
                          backgroundColor: "var(--surface-2)",
                          color: "var(--text-secondary)",
                        }
                  }
                >
                  {g.label}
                </button>
              );
            })}
          </div>
        )}
      </section>

      {/* السعر والوصف */}
      <section className="flex flex-col gap-4 border-t border-border pt-6">
        <h2 className="text-sm font-semibold uppercase tracking-wider text-text-secondary">
          السعر والوصف
        </h2>

        <div>
          <label className="mb-1.5 block text-sm font-medium">السعر المطلوب (جنيه) *</label>
          <input name="askingPrice" type="number" required min={0} step="1" className={FIELD_CLASS} />
        </div>

        <div>
          <label className="mb-1.5 block text-sm font-medium">الوصف *</label>
          <textarea name="description" required minLength={10} maxLength={2000} rows={4} className={FIELD_CLASS} placeholder="اكتب تفاصيل الحالة، سنة الشراء، وأي عيوب إن وجدت..." />
        </div>
      </section>

      {/* الصور */}
      <section className="flex flex-col gap-4 border-t border-border pt-6">
        <h2 className="text-sm font-semibold uppercase tracking-wider text-text-secondary">
          الصور (5 على الأقل) *
        </h2>

        <label
          htmlFor="sell-images"
          className="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-border bg-surface-2 px-4 py-8 text-center transition hover:border-gold/50"
        >
          <FiUploadCloud className="h-6 w-6 text-text-muted" />
          <span className="text-sm text-text-secondary">
            اضغط لرفع الصور — {images.length}/10
          </span>
          <input
            id="sell-images"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
            onChange={handleImageUpload}
            className="hidden"
          />
        </label>

        {previews.length > 0 && (
          <div className="grid grid-cols-3 gap-3 sm:grid-cols-5">
            {previews.map((p, i) => (
              <div key={i} className="group relative aspect-square overflow-hidden rounded-lg border border-border">
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img src={p.url} alt="" className="h-full w-full object-cover" />
                <button
                  type="button"
                  onClick={() => removeImage(i)}
                  aria-label="حذف الصورة"
                  className="absolute right-1 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-black/70 text-white opacity-0 transition group-hover:opacity-100"
                >
                  <FiX size={14} />
                </button>
              </div>
            ))}
          </div>
        )}
      </section>

      {error && (
        <p className="rounded-lg bg-error/10 px-4 py-3 text-sm text-error">{error}</p>
      )}

      <button
        type="submit"
        disabled={isSubmitting || images.length < 5}
        className="w-full rounded-full bg-gold py-3.5 font-semibold text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
        style={{ boxShadow: "0 0 24px rgba(212,175,106,0.3)" }}
      >
        {isSubmitting ? "جاري الإرسال..." : "إرسال طلب البيع"}
      </button>
    </form>
  );
}

