              <div className="px-4 py-4 border-t border-border">
                {typeof cart?.subtotal === "number" ? (
                  <div className="mb-4 flex items-center justify-between">
                    <p className="text-sm uppercase tracking-wide text-text-secondary">
                      {t("total")}
                    </p>
                    <div
                      className="rounded-full px-4 py-1 text-lg font-bold"
                      style={{
                        backgroundColor: "var(--gold)",
                        color: "#0a0a10",
                        boxShadow: "0 0 16px rgba(212,175,106,0.4)",
                      }}
                    >
                      <Price amount={cart.subtotal} />
                    </div>
                  </div>
                ) : null}

                <Button
                  eventName="begin_checkout"
                  className="w-full bg-gold text-black hover:bg-gold/80"
                >
                  <Link href="/checkout" onClick={() => setIsOpen(false)}>
                    {t("checkout")}
                  </Link>
                </Button>
              </div>
            </div>
          </div>
        )}
      </div>
    </>
  );
}

نقطة أمانة لازم أقولها: ItemConditionBadge بيفترض إن product.conditionType/product.conditionGrade موجودين جوه بيانات الـ cart item زي ما هما في new-arrivals.tsx. لو الـ buildCartRows (في lib/core/adapter.ts) مش بيرجّع الحقلين دول ضمن data.product، الشارة هتفضل مخفية بهدوء (بسبب if (!ct) return null) بدل ما تكسر الصفحة — لكن لو عايزها تشتغل فعليًا محتاج تتأكد إن الـ query اللي بيجيب الـ cart بيعمل populate لـ conditionType/conditionGrade على مستوى الـ product، وده حاجة في الـ DAL/API مش عندي شوفتها كاملة.

كمان لاحظت إن زرار الـ checkout في النسخة الأصلية كان فيه variant="secondary" مع !border !border-border — استبدلته بـ bg-gold text-black عشان يبقى متسق مع كل أزرار الفعل الرئيسية التانية في الموقع (Add to Cart، Sell، Checkout submit)، مش لون تاني بيشتت.